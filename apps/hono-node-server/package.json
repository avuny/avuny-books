{
  "name": "@avuny/hono-node-server",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "author": {
    "name": "Khaled Eleskandrany",
    "email": "khaledeskandrany@gmail.com"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schemas": "./src/schemas.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "concurrently \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"tsx watch src/index.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "api:extract": "api-extractor run --local",
    "api:docs": "api-documenter markdown -i temp -o docs",
    "clean:build": "rm -rf dist tsconfig.build.tsbuildinfo .turbo",
    "clean:modules": "rm -rf node_modules",
    "clean:all": "pnpm clean:modules && pnpm clean:build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@microsoft/api-documenter": "^7.26.29",
    "@microsoft/api-extractor": "^7.52.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qs": "^6.14.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.3",
    "concurrently": "^10.0.5",
    "eslint": "^9.28.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.3",
    "zod": "^4.0.5"
  },
  "dependencies": {
    "@avuny/api": "workspace:*",
    "@avuny/zod": "workspace:*",
    "@hono/node-server": "^2.1.4",
    "@hono/structured-logger": "^0.1.0",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.5",
    "dotenv": "^17.4.2"
  }
}