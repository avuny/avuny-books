# Environment variables for apps/hono-node-server
# Copy to .env and fill in real values. Never commit .env.
# Durations: s = seconds, m = minutes, h = hours, d = days.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/avuny_dev

# ── Tokens and sessions ───────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=replace-with-at-least-32-chars-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Must be >= REFRESH_TOKEN_TTL. No new column; absolute lifetime derived from sessions.created_at.
SESSION_ABSOLUTE_TTL=90d
VERIFICATION_TOKEN_SECRET=replace-with-at-least-32-chars-secret
VERIFICATION_TOKEN_TTL=15m

# ── Passwords and OTP ─────────────────────────────────────────────────────────
# Cost factor for bcryptjs. 12 in production; 4 in tests (keep sign-in p95 < ~500ms).
BCRYPT_ROUNDS=12
OTP_SECRET=replace-with-at-least-32-chars-secret
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60s
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=20

# ── Sign-in throttling (Postgres-backed; no Redis assumed) ────────────────────
SIGNIN_MAX_FAILURES_PER_IDENTIFIER=5
SIGNIN_MAX_FAILURES_PER_IP=20
SIGNIN_THROTTLE_WINDOW=15m

# ── Web / CORS ────────────────────────────────────────────────────────────────
# strict | lax | none. none requires CORS_ORIGINS.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=yourdomain.com
# Comma-separated list of allowed origins. Never use *.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUSTED_PROXY_IP_HEADER=x-forwarded-for

# ── Background work ───────────────────────────────────────────────────────────
# waituntil (serverless) | node (fire-and-forget) | inline (tests only; refused in production).
BACKGROUND_RUNNER=node

# ── Avatar / storage ──────────────────────────────────────────────────────────
AVATAR_MAX_BYTES=2097152
# STORAGE_ENDPOINT=https://s3.amazonaws.com
# STORAGE_BUCKET=avuny-avatars
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_BASE_URL=https://cdn.yourdomain.com

# ── Delivery — email ──────────────────────────────────────────────────────────
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=no-reply@yourdomain.com
# EMAIL_PASS=
# EMAIL_FROM="Avuny <no-reply@yourdomain.com>"

# ── Delivery — WhatsApp ───────────────────────────────────────────────────────
# WHATSAPP_API_URL=https://graph.facebook.com/v19.0
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ── Audit ─────────────────────────────────────────────────────────────────────
AUDIT_RETENTION_DAYS=365
AUDIT_HMAC_SECRET=replace-with-at-least-32-chars-secret
