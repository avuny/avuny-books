{
  "name": "avuny-books",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "dev": "TURBO_UI=0  turbo dev --concurrency=20",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "api:generate": "turbo api:generate",
    "clean:build": "turbo clean:build --concurrency=20",
    "clean:packages": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && rm -f pnpm-lock.yaml",
    "clean:all": "pnpm run clean:build && pnpm run clean:packages",
    "print-files": "node ./scripts/print-files.js",
    "openapi:generate": "turbo run openapi:generate --filter=@avuny/api"
  },
  "devDependencies": {
    "@avuny/eslint-config": "workspace:*",
    "@avuny/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0"
  }
}